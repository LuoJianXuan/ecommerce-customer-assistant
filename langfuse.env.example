# 可选 Langfuse 本地栈：复制为 langfuse.env 后自行填写，真实文件不进 Git。
# 密码建议使用独立的随机十六进制字符串，避免 URL 特殊字符转义问题。
# 可在本机生成：python -c "import secrets; print(secrets.token_hex(32))"
# ENCRYPTION_KEY 必须填写 64 位十六进制字符串（32 字节）；各项分别生成。
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
MINIO_PASSWORD=
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
