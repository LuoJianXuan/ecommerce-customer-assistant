# ============================================================
# 单一激活配置：换供应商只改下面三行（应用侧统一走 OpenAI 协议）
# ============================================================

# DeepSeek 官方平台（OpenAI 兼容模式，当前默认）
LLM_BASE_URL=https://api.deepseek.com/v1

# DeepSeek 开放平台创建的 API Key（sk- 开头）
LLM_API_KEY=sk-your-deepseek-api-key

# 模型名：deepseek-flash（当前版本 V4.1-Flash）/ deepseek-v4-pro（更强档）
LLM_MODEL=deepseek-flash

# ---------- 其他可选 ----------
# 生成温度
LLM_TEMPERATURE=0.7
# DeepSeek 默认开启思考模式，但本项目的结构化输出/Agent 依赖强制工具选择，需关闭
LLM_THINKING_ENABLED=false
# 多轮历史消息的 token 预算（发送窗口，超出从最旧开始裁剪）
HISTORY_TOKEN_BUDGET=2000
# 客服所属平台名（注入 System Prompt 模板变量）
PLATFORM_NAME=云优选

# ---------- 数据库（ch02 起，Docker MySQL；compose 默认映射 3307:3306） ----------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
# 为本地 MySQL 设置自己的口令；该值同时由 Compose 和应用读取
DB_PASSWORD=
DB_NAME=kefu
# 工具执行超时（秒）与重试次数
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=1

# 单次模型调用超时（秒）
LLM_CALL_TIMEOUT_SECONDS=60

# ---------- ch03 知识库 ----------
# Compose 宿主端口；修改 MILVUS_PORT 时同步更新 MILVUS_URI
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge
EMBED_MODEL_NAME=BAAI/bge-m3
HF_HOME=.hf_cache            # 模型缓存目录（相对项目）
RETRIEVAL_TOP_K=3
RETRIEVAL_EXCLUDED_CATEGORIES=对话挖掘  # 英文逗号分隔；历史挖掘知识默认隔离
MINE_INTERVAL_HOURS=0        # 挖知识定时任务间隔（小时，<=0 关闭）

# ---------- ch04 检索策略 ----------
RETRIEVAL_STRATEGY=hybrid_rerank   # dense | bm25 | hybrid | hybrid_rerank
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RECALL_TOP_K=50                    # 两路各召回条数（RRF 融合前）
RERANK_CANDIDATES=6              # 进重排的候选数（最新冻结评估使用 6；调整后需另跑评估）
RERANK_TOP_K=10                    # 重排后保留条数
QUERY_REWRITE_ENABLED=true         # 口语改写+同义词（检索侧）
FAQ_TOOL_TIMEOUT_SECONDS=12        # query_faq 工具超时（改写+检索+重排总预算）

# ---------- ch05 Agent 工作流 ----------
EVIDENCE_CONF_THRESHOLD=0.2 # 当前运行阈值；最新同集诊断与冻结结果见 docs/evaluation.md
AGENT_MAX_STEPS=5           # ReAct 步数上限

# ---------- ch06 分流器 ----------
INTENT_MODEL=                      # 意图识别/指代消解专用模型；留空=沿用 LLM_MODEL
INTENT_SMALL_MODEL=deepseek-flash  # 降级链路小模型（先行判断；官方仅此两档模型）
INTENT_ESCALATION_ENABLED=false    # 两级降级：小模型先判，置信度低才升级大模型重判一次
INTENT_CONFIDENCE_THRESHOLD=0.6    # 触发升级的置信度阈值

# ---------- ch07 上下文管理 ----------
# 预算从窗口倒推：换模型只改 MODEL_CONTEXT_WINDOW，整张预算表重算。
# 演示配置（触发级联验收用，算出 滑窗5650/层1 3954/层2 1695）：
#   MODEL_CONTEXT_WINDOW=18000 MAX_OUTPUT_TOKENS=2000 MAX_USER_INPUT_TOKENS=2000
#   MAX_AGENT_STEPS=3 TOOL_RESULT_MAX_TOKENS=1200 RERANK_TOP_K=5
MODEL_CONTEXT_WINDOW=32768
MAX_OUTPUT_TOKENS=2000
MAX_USER_INPUT_TOKENS=2000
TOOL_RESULT_MAX_TOKENS=1200
CTX_SYSTEM_PROMPT_TOKENS=700
CTX_WANT_ROUNDS=10
CTX_STEADY_PER_ROUND=565
CTX_SAFETY_RATIO=0.10
CTX_SUMMARY_INJECT_SEGMENTS=3
CTX_SUMMARY_SEGMENT_MAX_TOKENS=200
CTX_EVIDENCE_PER_CHUNK_TOKENS=300
CTX_ASSISTANT_HEAD_CHARS=80

# ---------- ch08 工具系统(MCP) ----------
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALE_URL=http://127.0.0.1:8102/mcp

# ---------- ch09 Langfuse 观测 ----------
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
EVAL_GEN_LIMIT=0             # 旧工作台生成段：0=全量；新审计入口固定跑 100 题
EVAL_DAILY_HOUR=0            # 每日几点执行（Asia/Shanghai；<=0 关闭）

# ---------- ch10 本地主题分类（旁路批处理，不调用在线 LLM） ----------
TOPIC_MODEL_PATH=training/model_out/best
TOPIC_DEVICE=auto                    # auto | cuda | cpu
TOPIC_BATCH_SIZE=64
TOPIC_THRESHOLD_FALLBACK=0.5         # 仅模型目录没有 topic_threshold.json 时使用
TOPIC_AUTO_BATCH_ENABLED=false       # 手动按钮为主，自动攒批默认关闭
TOPIC_AUTO_BATCH_MIN_PENDING=100
TOPIC_AUTO_BATCH_LIMIT=500
TOPIC_AUTO_BATCH_INTERVAL_MINUTES=10
